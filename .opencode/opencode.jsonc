{
  "$schema": "https://opencode.ai/config.json",

  // Zakres: WYŁĄCZNIE to repozytorium. Plik leży w .opencode/, więc działa
  // tylko tutaj — nie zmienia konfiguracji globalnej (~/.config/opencode/)
  // ani innych projektów. Agent Engineer, skille i komendy są projektowe.
  // ---------------------------------------------------------------------------

  // Domyślny agent w tym projekcie — nowe sesje startują jako Engineer.
  "default_agent": "Engineer",

  // ---------------------------------------------------------------------------
  // Polityki — w tym projekcie działa wyłącznie serwer MCP kicad.
  // Reguła szeroka (deny) jest na początku, wyjątek (allow) na końcu —
  // wygrywa ostatnia pasująca reguła. Kolejność: najpierw szeroko, potem wyjątki.
  // ---------------------------------------------------------------------------
  "policies": [
    { "action": "integration.use", "resource": "mcp:*", "effect": "deny" },
    { "action": "integration.use", "resource": "mcp:kicad", "effect": "allow" }
  ],

  // ---------------------------------------------------------------------------
  // Serwery MCP — jedyne narzędzia zewnętrzne dopuszczone w tym projekcie
  // ---------------------------------------------------------------------------
  "mcp": {
    "timeout": {
      // Pierwsze uruchomienie serwera KiCad tworzy venv i instaluje zależności
      // w Pythonie, dlatego start może zająć kilka minut.
      "startup": 1200000,
      "catalog": 180000,
      "execution": 1800000
    },
    "servers": {
      // KiCad MCP: odczyt i bezpieczna edycja plików KiCad, inspekcja netlisty,
      // ERC/DRC, raport gotowości produkcyjnej, eksporty fabrykacyjne.
      // Wymaga Node.js; pełny zakres funkcji (ERC/DRC, gerbery) wymaga
      // zainstalowanego KiCad + kicad-cli w PATH.
      "kicad": {
        "type": "local",
        "command": ["npx", "-y", "kicad-mcp"]
      }
    }
  },

  // ---------------------------------------------------------------------------
  // Uprawnienia globalne (mają niższy priorytet niż reguły w agentach)
  // ---------------------------------------------------------------------------
  "permissions": [
    { "action": "skill", "resource": "*", "effect": "allow" },
    { "action": "webfetch", "resource": "*", "effect": "allow" },
    { "action": "websearch", "resource": "*", "effect": "allow" }
  ]
}
